{
  "name": "income-outcome",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "income-outcome-db",
      "database_id": "44e4c872-68ef-44d3-b707-f6d979631da4",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  },
  "vars": {
    "AUTH_SECRET": "supersecret1234567890"
  }
}
