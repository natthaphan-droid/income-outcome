sync=\"\"></script><title>JustNavigate - Money Tracker</title><meta name=\"description\" content=\"Minimalist money tracker\"/><link rel=\"manifest\" href=\"/manifest.json\"/><link rel=\"icon\" href=\"/icon.jpg?ffe84f67ff2dad1d\" type=\"image/jpeg\" sizes=\"820x820\"/><link rel=\"apple-touch-icon\" href=\"/apple-icon.jpg?ffe84f67ff2dad1d\" type=\"image/jpeg\" sizes=\"820x820\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"min-h-full flex flex-col bg-background text-foreground\"><div hidden=\"\"><!--$--><!--/$--></div><script>((a,b,c,d,e,f,g,h)=>{let i=document.documentElement,j=[\"light\",\"dark\"];function k(b){var c;(Array.isArray(a)?a:[a]).forEach(a=>{let c=\"class\"===a,d=c&&f?e.map(a=>f[a]||a):e;c?(i.classList.remove(...d),i.classList.add(f&&f[b]?f[b]:b)):i.setAttribute(a,b)}),c=b,h&&j.includes(c)&&(i.style.colorScheme=c)}if(d)k(d);else try{let a=localStorage.getItem(b)||c,d=g&&\"system\"===a?window.matchMedia(\"(prefers-color-scheme: dark)\").matches?\"dark\":\"light\":a;k(d)}catch(a){}})(\"class\",\"theme\",\"theme-dino-green\",null,[\"light\",\"dark\"],null,true,true)</script><!--$--><div class=\"min-h-screen bg-background flex flex-col\"><header class=\"px-6 py-6 bg-primary text-primary-foreground shadow-md flex items-center gap-4 sticky top-0 z-10\"><button class=\"text-primary-foreground p-2 -ml-2 rounded-full hover:bg-primary/80 transition-colors\"><svg class=\"w-6 h-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M10 19l-7-7m0 0l7-7m-7 7h18\"></path></svg></button><h1 class=\"text-xl font-bold\">ประกาศการอัปเดต</h1></header><main class=\"p-6\"><div class=\"relative border-l-2 border-[primary] ml-4 space-y-10 pb-10\"><div class=\"relative pl-6\"><div class=\"absolute -left-2 top-1 w-4 h-4 bg-primary rounded-full border-4 border-background\"></div><div class=\"mb-1 text-sm text-foreground font-bold\">เวอร์ชัน 1.1.0 (อัปเดตล่าสุด)</div><div class=\"mb-2 text-xs text-muted\">6 กันยายน 2026</div><div class=\"bg-card text-card-foreground p-4 rounded-xl border border-border shadow-sm\"><h3 class=\"font-medium text-sm mb-2\">✨ อัปเดตฟีเจอร์ใหม่เพียบ!</h3><ul class=\"text-sm text-muted space-y-2 list-none\"><li class=\"flex gap-2\"><span>🎨</span> <span><b>ระบบ 6 ธีมใหม่:</b> เลือกบรรยากาศที่คุณชอบได้ตามใจ (มินิมอล, โหมดกลางคืน, ชมพูพาสเทล ฯลฯ)</span></li><li class=\"flex gap-2\"><span>🦖</span> <span><b>หน้าโหลดใหม่:</b> เพิ่มมาสคอตน้องไดโนเสาร์กระโดดเด้งดึ๋งแก้เบื่อตอนรอโหลดและสลับธีม</span></li><li class=\"flex gap-2\"><span>⚠️</span> <span><b>แจ้งเตือนงบ:</b> หน้าต่าง Popup เด้งเตือนกลางจอทันที เมื่อเงินในหมวดหมู่เหลือน้อยกว่า 5%</span></li><li class=\"flex gap-2\"><span>🐛</span> <span><b>แก้ไขบัค:</b> ซ่อมกล่องข้อความ (Tooltip) ในกราฟแท่งที่เคยเป็นสีดำ ให้กลับมาเป็นสีขาวอ่านง่าย</span></li><li class=\"flex gap-2\"><span>💅</span> <span><b>ปรับ UI:</b> เปลี่ยนสีแถบด้านบน (Header) ให้ตัดกับพื้นหลังชัดเจนขึ้น</span></li></ul></div></div><div class=\"relative pl-6\"><div class=\"absolute -left-2 top-1 w-4 h-4 bg-surface rounded-full border-4 border-background\"></div><div class=\"mb-1 text-sm text-foreground font-bold\">เวอร์ชัน 1.0.0</div><div class=\"mb-2 text-xs text-muted\">4 กันยายน 2026</div><div class=\"bg-card text-card-foreground p-4 rounded-xl border border-border shadow-sm\"><h3 class=\"font-medium text-sm mb-2\">🎉 เปิดตัวแอปพลิเคชันอย่างเป็นทางการ</h3><ul class=\"text-sm text-muted space-y-1 list-disc pl-4\"><li>ธีมมินิมอลสีไม้ และสีพื้นขาวสะอาดตา (#B38B6D + #FDFBF7)</li><li>ระบบล็อกอินด้วย PIN 6 หลักเพื่อความปลอดภัย</li><li>จัดสรรงบประมาณรายเดือนพร้อมแจ้งเตือน 5% สุดท้าย</li><li>สรุปผลกราฟแท่งแนวโน้มรายสัปดาห์</li><li>สามารถส่งออกข้อมูลเป็น CSV ได้</li></ul></div></div></div></main></div><!--$--><!--/$--><!--/$--><script src=\"/_next/static/chunks/webpack-dafb6c2dbcb9a8b8.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push